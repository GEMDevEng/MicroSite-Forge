{
  "users": {
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "not_null": true,
        "references": "auth.users(id)"
      },
      "email": {
        "type": "text",
        "not_null": true
      },
      "stripe_id": {
        "type": "text",
        "nullable": true
      },
      "twilio_sid": {
        "type": "text",
        "nullable": true
      },
      "preferred_gateway": {
        "type": "text",
        "nullable": true
      },
      "gateway_credentials": {
        "type": "jsonb",
        "nullable": true
      },
      "created_at": {
        "type": "timestamptz",
        "not_null": true,
        "default": "now()"
      },
      "updated_at": {
        "type": "timestamptz",
        "not_null": true,
        "default": "now()"
      }
    },
    "indexes": [
      "CREATE UNIQUE INDEX idx_users_email ON users(email)",
      "CREATE INDEX idx_users_stripe_id ON users(stripe_id)"
    ]
  },
  "sites": {
