  "communications": {
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "not_null": true,
        "default": "uuid_generate_v4()"
      },
      "lead_id": {
        "type": "uuid",
        "not_null": true,
        "references": "leads(id)"
      },
      "type": {
        "type": "text",
        "not_null": true,
        "check": "type IN ('email', 'sms', 'call', 'note')"
      },
      "direction": {
        "type": "text",
        "not_null": true,
        "check": "direction IN ('inbound', 'outbound')"
      },
      "content": {
        "type": "text",
        "not_null": true
      },
      "status": {
        "type": "text",
        "nullable": true
