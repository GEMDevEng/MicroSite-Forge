{
  "name": "microsite-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered microsite factory for local lead generation",
  "keywords": [
    "nextjs",
    "supabase",
    "ai",
    "microsites",
    "lead-generation"
  ],
  "author": "MicroSite Forge Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.cjs",
    "test:e2e": "playwright test",
    "deploy:staging": "vercel --scope your-org",
    "deploy:production": "vercel --prod --scope your-org",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
