{
  "name": "microsite-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered microsite factory for local lead generation",
  "keywords": [
    "nextjs",
    "supabase",
    "ai",
    "microsites",
    "lead-generation"
  ],
  "author": "MicroSite Forge Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=60",
    "lint:fix": "eslint . --fix --max-warnings=60",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.cjs",
    "test:e2e": "playwright test",
  "test:e2e:ci": "next build && playwright test",
  "test:e2e:local": "playwright test --config=playwright.local.config.ts",
  "check:playwright-dom": "node scripts/scan-dom-access.js",
    "deploy:staging": "vercel --scope your-org",
    "deploy:production": "vercel --prod --scope your-org",
    "format": "prettier --write .",
    "verify:auth": "node scripts/verify-auth-setup.js",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "fix:imports": "npx replace-in-file '../../types/supabase' '../../types/database.types' \"src/**/*.ts\" \"src/**/*.tsx\"",
    "db:build": "node scripts/automated-schema-builder.js",
    "db:generate": "node scripts/generate-migration.js",
    "db:generate:rls": "node scripts/generate-rls.js",
    "db:deploy:local": "node scripts/deploy-schema.js deploy",
    "db:reset": "node scripts/deploy-schema.js reset",
    "db:status": "supabase status",
    "db:studio": "supabase studio",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "types:generate": "node scripts/generate-types.js",
    "types:check-freshness": "node scripts/generate-types.js check-freshness",
    "types:sync": "node scripts/sync-types.js",
    "types:sync:pull": "node scripts/sync-types.js pull",
    "types:sync:push": "node scripts/sync-types.js push",
    "types:sync:status": "node scripts/sync-types.js status",
    "types:validate": "npm run type-check",
    "types:strict-validate": "node scripts/generate-types.js check-freshness strict && npm run type-check",
    "prebuild": "npm run types:generate"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npx replace-in-file '../../types/supabase' '../../types/database.types'"
    ],
    "*": [
      "npx supabase gen types typescript --project-id anaeyyikvoxwoefpxilf --schema public --no-merkatz > types/database.types.ts"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@sentry/nextjs": "^10.17.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.38.0",
    "@vercel/analytics": "^1.5.0",
    "chart.js": "^4.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "next": "^15.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.47.0",
    "swr": "^2.2.4",
    "tailwind-merge": "^2.0.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.16",
    "domexception": "^4.0.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "glob": "^9.3.5",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "replace-in-file": "^8.3.0",
    "rimraf": "^4.4.1",
    "supabase": "^2.45.5",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "whatwg-fetch": "^3.6.20"
  },
  "engines": {
    "node": ">=20.6.0",
    "npm": ">=9.8.0"
  }
}
