    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.2.5",
