NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: For GitHub OAuth to work, you need to:
# 1. Go to https://github.com/settings/developers and create a new OAuth App
# 2. Set Authorization callback URL to: https://your-project.supabase.co/auth/v1/callback
# 3. Add the Client ID and Client Secret to Supabase Dashboard > Authentication > Providers > GitHub
