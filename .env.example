# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MicroSite Forge"

# Supabase Configuration (from Phase 1)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth Configuration
# Site URL for OAuth redirects (must match Supabase dashboard configuration)
# For local development: http://localhost:3000
# For production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI APIs (Required for Phase 2)
GROK_API_KEY=your_grok_api_key
OPENAI_API_KEY=your_openai_api_key

# Communication Services
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
VAPI_API_KEY=your_vapi_api_key

# Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email Services
SENDGRID_API_KEY=your_sendgrid_api_key
MAILGUN_API_KEY=your_mailgun_api_key

# Deployment Services
NETLIFY_AUTH_TOKEN=your_netlify_auth_token
GITHUB_TOKEN=your_github_token
VERCEL_TOKEN=your_vercel_token

# Domain Services
PORKBUN_API_KEY=your_porkbun_api_key
PORKBUN_SECRET_KEY=your_porkbun_secret_key

# Monitoring & Analytics
SENTRY_DSN=your_sentry_server_dsn
NEXT_PUBLIC_SENTRY_DSN=your_sentry_client_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
UPTIME_ROBOT_API_KEY=your_uptime_robot_api_key
UPTIME_ROBOT_MONITOR_ID=your_uptime_robot_monitor_id

# Database Monitoring
SUPABASE_DATABASE_URL=your_supabase_database_url

# Development
NODE_ENV=development
DATABASE_URL=your_database_url
